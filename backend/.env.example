NODE_ENV=production
PORT=4000
ASSESSMENT_API_INFLIGHT_LIMIT=48
ASSESSMENT_FINAL_INFLIGHT_LIMIT=32
FRONTEND_ORIGIN=https://peerprep.co.in
FRONTEND_URL=https://peerprep.co.in

# Use a restricted application user. URL-encode reserved password characters.
MONGODB_URI=mongodb://app_user:ENCODED_PASSWORD@127.0.0.1:27017/app?authSource=app&directConnection=true
# One API and one frontend serve the platform and every university.
# MONGODB_URI is the existing main PeerPrep database. University database URIs
# and Judge0 endpoints are entered in the superadmin dashboard.
PEERPREP_DEPLOYMENT_ROLE=shared
# Generate once with `openssl rand -base64 32`; use the SAME value on all API
# and worker processes and keep it stable across deploys.
PEERPREP_TENANT_SECRET_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
# Workers call the main API for centrally published content.
# PEERPREP_SHARED_API_ORIGIN=https://peerprep.co.in
# MONGODB_TENANT_MAX_POOL_SIZE=20
# Maximum UTF-8 bytes for one server-persisted hidden testcase input.
# Learner-provided custom input remains capped at 64 KiB.
PERSISTED_TESTCASE_MAX_INPUT_BYTES=4194304
MONGODB_MAX_POOL_SIZE=30
MONGODB_MIN_POOL_SIZE=5
MONGODB_MAX_CONNECTING=2
MONGODB_MAX_IDLE_TIME_MS=30000
MONGODB_WAIT_QUEUE_TIMEOUT_MS=5000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_SOCKET_TIMEOUT_MS=30000

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=

# Optional split endpoints; legacy REDIS/VALKEY settings remain the fallback.
# Development can use one server. Production queue storage requires noeviction;
# an evictable cache should be a separate instance, not just another Redis DB.
# CACHE_VALKEY_URL=redis://127.0.0.1:6379
# QUEUE_VALKEY_URL=redis://127.0.0.1:6380
# SOCKET_VALKEY_URL=redis://127.0.0.1:6379
CACHE_CONNECT_TIMEOUT_MS=1000
CACHE_COMMAND_TIMEOUT_MS=250
QUEUE_CONNECT_TIMEOUT_MS=2000
QUEUE_COMMAND_TIMEOUT_MS=2000
BULLMQ_QUEUE_PREFIX=peerprep:bullmq:v1
QUEUE_COMPLETED_RETENTION_SECONDS=604800
QUEUE_FAILED_RETENTION_SECONDS=2592000
WORKER_DRAIN_TIMEOUT_MS=30000
EXECUTION_JOB_LOCK_MS=60000
SOCKET_REDIS_ENABLED=true
SOCKET_IO_CHANNEL=peerprep:socket:v1
# Set LEGACY_QUEUE_URL to the OLD endpoint if changing queue servers at cutover.
# LEGACY_QUEUE_URL=redis://127.0.0.1:6379

# A single-process install needs the mail consumer in the API process. If mail
# is handled by another always-on process, disable this there explicitly.
START_EXECUTION_WORKERS=false
START_SCHEDULED_JOBS=false
START_MAIL_WORKER=true
# Set SMTP credentials on every process that sends mail. ADMIN_EMAIL is only
# the bootstrap login and does not configure an SMTP sender.
EMAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
COMPILER_WORKER_CONCURRENCY=2
ASSESSMENT_WORKER_CONCURRENCY=2

AUTH_SESSION_CACHE_TTL_MS=30000
ASSESSMENT_ACTIVE_SESSION_FRESH_MS=45000
# Default: reconnect never extends exam time from a browser-supplied timestamp.
# Opt-in credits only server-observed gaps before the original deadline, with caps.
ASSESSMENT_NETWORK_PAUSE_CREDIT_ENABLED=false
# Enable only after updated frontend is deployed and older active clients drain.
# Requires submission ID, attempt generation, mutation ID and save sequence.
ASSESSMENT_REQUIRE_SAVE_PROTOCOL=false
# Private Supabase bucket with matching server-side MIME/size restrictions.
# Missing bucket keeps the bounded legacy image path in the separate event store.
# ASSESSMENT_EVIDENCE_BUCKET=assessment-evidence
ASSESSMENT_EVIDENCE_MAX_BYTES=1048576
# ASSESSMENT_EVIDENCE_SIGNING_SECRET=use-a-dedicated-random-secret
API_REQUEST_TIMEOUT_MS=20000
LONG_API_REQUEST_TIMEOUT_MS=120000
SLOW_REQUEST_THRESHOLD_MS=750

# Successful heartbeat/monitoring access lines are skipped by default.
LOG_NOISY_ASSESSMENT_REQUESTS=false
# Cloudinary image storage for coding-problem images, avatars, and university logos (required in production).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# --- Avatar Studio: private Cloudflare R2 S3 credentials ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=peerprep-avatars
# Optional override; otherwise derived from R2_ACCOUNT_ID.
R2_ENDPOINT=

# --- Avatar Studio: separate CPU rendering service ---
# Share a strong random token with services/avatar-renderer/.env.
AVATAR_RENDER_SERVICE_URL=http://127.0.0.1:8010
AVATAR_RENDER_SERVICE_TOKEN=
AVATAR_MAX_UPLOAD_MB=25
AVATAR_MAX_INTRO_SECONDS=60
# Optional self-hosted TTS/STT, not Hugging Face's paid hosted inference API.
AVATAR_TTS_ENABLED=false
AVATAR_STT_ENABLED=false

# --- Optional Gemini introduction assistant ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# --- Optional internal Python analytics intelligence runtime ---
# Disabled keeps Admin Analytics entirely on the Node formulas.
ANALYTICS_PYTHON_ENABLED=false
ANALYTICS_PYTHON_URL=http://127.0.0.1:8000
# Use a dedicated random secret of at least 32 bytes; do not reuse JWT_SECRET.
ANALYTICS_PYTHON_JWT_SECRET=
ANALYTICS_PYTHON_TIMEOUT_MS=2500
ANALYTICS_PYTHON_MAX_PAYLOAD_BYTES=8388608
ANALYTICS_PYTHON_MAX_RESPONSE_BYTES=2097152
ANALYTICS_PYTHON_JWT_TTL_SECONDS=30
ANALYTICS_PYTHON_BREAKER_THRESHOLD=3
ANALYTICS_PYTHON_BREAKER_COOLDOWN_MS=30000
# Only for trusted private service networks when TLS terminates elsewhere.
ANALYTICS_PYTHON_ALLOW_INSECURE_HTTP=false
