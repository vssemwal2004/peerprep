NODE_ENV=production
PORT=4000
ASSESSMENT_API_INFLIGHT_LIMIT=48
ASSESSMENT_FINAL_INFLIGHT_LIMIT=32
FRONTEND_ORIGIN=https://peerprep.co.in
FRONTEND_URL=https://peerprep.co.in

# Use a restricted application user. URL-encode reserved password characters.
MONGODB_URI=mongodb://app_user:ENCODED_PASSWORD@127.0.0.1:27017/app?authSource=app&directConnection=true
# One API and one frontend serve the platform and every university.
# MONGODB_URI is the existing main PeerPrep database. University database URIs
# and Judge0 endpoints are entered in the superadmin dashboard.
PEERPREP_DEPLOYMENT_ROLE=shared
# Generate once with `openssl rand -base64 32`; use the SAME value on all API
# and worker processes and keep it stable across deploys.
PEERPREP_TENANT_SECRET_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
# Workers call the main API for centrally published content.
# PEERPREP_SHARED_API_ORIGIN=https://peerprep.co.in
# MONGODB_TENANT_MAX_POOL_SIZE=20
# Maximum UTF-8 bytes for one server-persisted hidden testcase input.
# Learner-provided custom input remains capped at 64 KiB.
PERSISTED_TESTCASE_MAX_INPUT_BYTES=4194304
MONGODB_MAX_POOL_SIZE=30
MONGODB_MIN_POOL_SIZE=5
MONGODB_MAX_CONNECTING=2
MONGODB_MAX_IDLE_TIME_MS=30000
MONGODB_WAIT_QUEUE_TIMEOUT_MS=5000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_SOCKET_TIMEOUT_MS=30000

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=

# Optional split endpoints; legacy REDIS/VALKEY settings remain the fallback.
# Development can use one server. Production queue storage requires noeviction;
# an evictable cache should be a separate instance, not just another Redis DB.
# CACHE_VALKEY_URL=redis://127.0.0.1:6379
# QUEUE_VALKEY_URL=redis://127.0.0.1:6380
# SOCKET_VALKEY_URL=redis://127.0.0.1:6379
CACHE_CONNECT_TIMEOUT_MS=1000
CACHE_COMMAND_TIMEOUT_MS=250
QUEUE_CONNECT_TIMEOUT_MS=2000
QUEUE_COMMAND_TIMEOUT_MS=2000
BULLMQ_QUEUE_PREFIX=peerprep:bullmq:v1
QUEUE_COMPLETED_RETENTION_SECONDS=604800
QUEUE_FAILED_RETENTION_SECONDS=2592000
WORKER_DRAIN_TIMEOUT_MS=30000
EXECUTION_JOB_LOCK_MS=60000
SOCKET_REDIS_ENABLED=true
SOCKET_IO_CHANNEL=peerprep:socket:v1
# Set LEGACY_QUEUE_URL to the OLD endpoint if changing queue servers at cutover.
# LEGACY_QUEUE_URL=redis://127.0.0.1:6379

# A single-process install needs the mail consumer in the API process. If mail
# is handled by another always-on process, disable this there explicitly.
START_EXECUTION_WORKERS=false
START_SCHEDULED_JOBS=false
START_MAIL_WORKER=true
# Set SMTP credentials on every process that sends mail. ADMIN_EMAIL is only
# the bootstrap login and does not configure an SMTP sender.
EMAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
COMPILER_WORKER_CONCURRENCY=16
ASSESSMENT_WORKER_CONCURRENCY=32
# Judge0 gateway: node-wide limit on parallel submissions, shared by every
# process through the queue Valkey. Measure the node before raising it: above
# its safe level correct solutions start to receive TLE.
JUDGE0_GATEWAY_ENABLED=true
JUDGE0_MAX_INFLIGHT=16
# Assessment work may use all but 2 slots (kept for final evaluation); practice is
# capped, and capped lower while any assessment executed in the last minute.
JUDGE0_GATEWAY_ASSESSMENT_MAX=14
# Runs share the assessment budget but stop 2 short of it, so submits always start.
JUDGE0_GATEWAY_ASSESSMENT_RUN_MAX=12
JUDGE0_GATEWAY_PRACTICE_MAX=6
JUDGE0_GATEWAY_PRACTICE_MAX_DURING_ASSESSMENT=3
JUDGE0_GATEWAY_MAX_WAIT_MS=300000
JUDGE0_CIRCUIT_FAILURES=5
JUDGE0_CIRCUIT_OPEN_MS=15000
JUDGE0_COMPILE_ALLOWANCE_MS=10000
# C++/Java jobs with several test cases compile once and run each case in its own
# process; anything but a clean, fast accepted case is re-judged per case.
JUDGE0_BATCH_EXECUTION=true
# Queued jobs wait this long for an unreachable Judge0 node before using a retry.
JUDGE0_NODE_OUTAGE_WAIT_MS=300000
PROBLEM_STATS_REFRESH_DELAY_MS=30000

AUTH_SESSION_CACHE_TTL_MS=30000
ASSESSMENT_ACTIVE_SESSION_FRESH_MS=45000
# Default: reconnect never extends exam time from a browser-supplied timestamp.
# Opt-in credits only server-observed gaps before the original deadline, with caps.
ASSESSMENT_NETWORK_PAUSE_CREDIT_ENABLED=false
# Enable only after updated frontend is deployed and older active clients drain.
# Requires submission ID, attempt generation, mutation ID and save sequence.
ASSESSMENT_REQUIRE_SAVE_PROTOCOL=false
# Private Supabase bucket with matching server-side MIME/size restrictions.
# Missing bucket keeps the bounded legacy image path in the separate event store.
# ASSESSMENT_EVIDENCE_BUCKET=assessment-evidence
ASSESSMENT_EVIDENCE_MAX_BYTES=1048576
# ASSESSMENT_EVIDENCE_SIGNING_SECRET=use-a-dedicated-random-secret
API_REQUEST_TIMEOUT_MS=20000
LONG_API_REQUEST_TIMEOUT_MS=120000
SLOW_REQUEST_THRESHOLD_MS=750

# Successful heartbeat/monitoring access lines are skipped by default.
LOG_NOISY_ASSESSMENT_REQUESTS=false
# Cloudinary image storage for coding-problem images, avatars, and university logos (required in production).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# --- Avatar Studio: private Cloudflare R2 S3 credentials ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=peerprep-avatars
# Optional override; otherwise derived from R2_ACCOUNT_ID.
R2_ENDPOINT=

# --- Avatar Studio: separate CPU rendering service ---
# Share a strong random token with services/avatar-renderer/.env.
AVATAR_RENDER_SERVICE_URL=http://127.0.0.1:8010
AVATAR_RENDER_SERVICE_TOKEN=
AVATAR_MAX_UPLOAD_MB=25
AVATAR_MAX_INTRO_SECONDS=60
# Optional self-hosted TTS/STT, not Hugging Face's paid hosted inference API.
AVATAR_TTS_ENABLED=false
AVATAR_STT_ENABLED=false

# --- Optional Gemini introduction assistant ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# --- ANVI hybrid runtime (turn-based interviews with cached question audio) ---
# Off by default: with ANVI_HYBRID_ENABLED=false every attempt runs on Gemini Live as before.
# Hybrid also needs every hybrid price below plus ANVI_USD_INR_RATE; otherwise attempts stay Live.
# All interviews are English; hybrid runs only for English attempts (voice Aoede, en-IN).
ANVI_HYBRID_ENABLED=false
ANVI_HYBRID_ROLLOUT_PERCENT=0
# Which attempts may run hybrid: attempt modes (practice,adaptive,mock) for self-started attempts and
# "scheduled" for assigned ones. Pilot: practice; later practice,scheduled.
ANVI_HYBRID_MODES=practice,adaptive,mock,scheduled
ANVI_HYBRID_LANGUAGES=English
ANVI_HYBRID_LIVE_ESCALATION=false
ANVI_LIVE_WARMUP=false
ANVI_BUDGET_ENFORCE_LIVE=false
# 60-minute interviews need ANVI_MAX_SESSION_MINUTES >= 60 (the default cap is 45).
# ANVI_MAX_SESSION_MINUTES=60
# Live minutes per interview duration (10/15/30/45/60 min); used only by Live escalation.
ANVI_MAX_LIVE_MINUTES_10=1
ANVI_MAX_LIVE_MINUTES_15=2
ANVI_MAX_LIVE_MINUTES_30=3
ANVI_MAX_LIVE_MINUTES_45=4
ANVI_MAX_LIVE_MINUTES_60=5
# Models (each kind has its own chain; empty fallback = none).
ANVI_TRANSCRIBE_ACCURATE_MODEL=gemini-3.5-transcribe
ANVI_DECISION_MODEL=gemini-3.5-flash-lite
ANVI_DECISION_FALLBACK_MODELS=
ANVI_EVALUATE_MODEL=gemini-3.6-flash
ANVI_EVALUATE_FALLBACK_MODELS=gemini-3.5-flash-lite
# Flash-Lite TTS is too slow (about 41-60 wpm); use it only after a pace test of at least 120 wpm.
ANVI_TTS_MODEL=gemini-3.8-flash-tts
ANVI_TTS_FALLBACK_MODEL=
ANVI_TTS_VOICE=Aoede
ANVI_TTS_LANGUAGE_CODE=en-IN
ANVI_TTS_MIN_WPM=110
ANVI_TTS_LOUDNESS_TARGET_DBFS=-17
ANVI_TTS_TIMEOUT_MS=20000
ANVI_TTS_CACHE_ENABLED=true
ANVI_TTS_CACHE_SCHEMA_VERSION=1
ANVI_TTS_SIGNED_URL_SECONDS=600
# none|minimal|low|medium|high per call kind (TTS never sends a thinking config).
ANVI_THINKING_TRANSCRIBE=minimal
ANVI_THINKING_TRANSCRIBE_ACCURATE=none
ANVI_THINKING_DECISION=minimal
ANVI_LIVE_USAGE_SEMANTICS=delta
# Question audio bucket (private R2; falls back to R2_BUCKET_NAME). Give the prefix
# anvi-audio-attempt/ its own lifecycle rule (e.g. delete after 7 days); anvi-audio/ is kept.
# ANVI_AUDIO_R2_BUCKET=peerprep-anvi-audio
# Per-attempt API budget in INR for a 60-minute interview; scaled by duration
# (safe budget 10/15/30/45/60 min = INR 15/20/35/48/60).
ANVI_BUDGET_ECONOMICAL_INR=30
ANVI_BUDGET_CACHED_ONLY_INR=40
ANVI_BUDGET_ESSENTIAL_INR=45
ANVI_BUDGET_HARD_INR=60
ANVI_BUDGET_EVALUATION_RESERVE_INR=5
ANVI_BUDGET_SCALE_BY_DURATION=true
# USD per 1M tokens charged by the budget for a token whose price is unknown.
ANVI_BUDGET_UNKNOWN_PRICE_USD_PER_M=20
# Prices: USD per 1M tokens (*_MINUTE: USD per minute of audio). Empty = unknown, never free.
# Verified values from https://ai.google.dev/gemini-api/docs/pricing ("Last updated 2026-10-19",
# paid Standard tier). gemini-3.6-flash and both TTS models roughly double on 2027-01-01:
# update these and ANVI_PRICING_REVISION / ANVI_PRICING_VALID_UNTIL on that date.
ANVI_PRICE_CURRENCY=USD
# ANVI_USD_INR_RATE=
ANVI_PRICING_REVISION=2026-10-19
ANVI_PRICING_VALID_UNTIL=2026-12-31
# gemini-3.8-live: text in 0.75, audio in 3.00 or 0.005/min; text out 4.50, audio out 12.00 or 0.018/min.
# ANVI_PRICE_LIVE_TEXT_INPUT=0.75
# ANVI_PRICE_LIVE_AUDIO_INPUT=3.00
# ANVI_PRICE_LIVE_AUDIO_INPUT_MINUTE=0.005
# ANVI_PRICE_LIVE_TEXT_OUTPUT=4.50
# ANVI_PRICE_LIVE_AUDIO_OUTPUT=12.00
# ANVI_PRICE_LIVE_AUDIO_OUTPUT_MINUTE=0.018
# gemini-3.5-flash-lite (transcribe, generate, decision): 0.30 in (any modality), 2.50 out.
# ANVI_PRICE_TRANSCRIBE_INPUT=0.30
# ANVI_PRICE_TRANSCRIBE_OUTPUT=2.50
# ANVI_PRICE_GENERATE_INPUT=0.30
# ANVI_PRICE_GENERATE_OUTPUT=2.50
# ANVI_PRICE_DECISION_INPUT=0.30
# ANVI_PRICE_DECISION_OUTPUT=2.50
# gemini-3.5-transcribe: audio in 2.00, out 12.00, or about 0.005 per audio minute blended.
# ANVI_PRICE_TRANSCRIBE_ACCURATE_AUDIO_INPUT=2.00
# ANVI_PRICE_TRANSCRIBE_ACCURATE_OUTPUT=12.00
# ANVI_PRICE_TRANSCRIBE_ACCURATE_AUDIO_MINUTE=0.005
# gemini-3.6-flash (evaluation): 0.75 in, 3.75 out including thinking (1.50 / 7.50 from 2027-01-01).
# ANVI_PRICE_EVALUATE_INPUT=0.75
# ANVI_PRICE_EVALUATE_OUTPUT=3.75
# gemini-3.8-flash-tts: text in 0.50, audio out 9.00 (doubles on 2027-01-01).
# (gemini-3.8-flash-lite-tts: text in 0.50, audio out 6.00, also doubles.)
# ANVI_PRICE_TTS_TEXT_INPUT=0.50
# ANVI_PRICE_TTS_AUDIO_OUTPUT=9.00

# --- Optional internal Python analytics intelligence runtime ---
# Disabled keeps Admin Analytics entirely on the Node formulas.
ANALYTICS_PYTHON_ENABLED=false
ANALYTICS_PYTHON_URL=http://127.0.0.1:8000
# Use a dedicated random secret of at least 32 bytes; do not reuse JWT_SECRET.
ANALYTICS_PYTHON_JWT_SECRET=
ANALYTICS_PYTHON_TIMEOUT_MS=2500
ANALYTICS_PYTHON_MAX_PAYLOAD_BYTES=8388608
ANALYTICS_PYTHON_MAX_RESPONSE_BYTES=2097152
ANALYTICS_PYTHON_JWT_TTL_SECONDS=30
ANALYTICS_PYTHON_BREAKER_THRESHOLD=3
ANALYTICS_PYTHON_BREAKER_COOLDOWN_MS=30000
# Only for trusted private service networks when TLS terminates elsewhere.
ANALYTICS_PYTHON_ALLOW_INSECURE_HTTP=false
