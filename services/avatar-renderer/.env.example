# No credentials/models are included. Supply the same long token in the Node backend.
AVATAR_RENDER_SERVICE_TOKEN=
AVATAR_ASSET_HOSTS=
AVATAR_RENDER_PORT=8010
AVATAR_WORK_DIR=./var/avatar-renderer
SADTALKER_ROOT=
SADTALKER_PYTHON=
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
AVATAR_MAX_INTRO_SECONDS=60
AVATAR_RENDER_TIMEOUT_SECONDS=1800
AVATAR_MAX_WAITING_JOBS=4
AVATAR_MAX_RETAINED_JOBS=200
# Optional, separate Python environments and explicitly downloaded LOCAL model directories.
AVATAR_TTS_PYTHON=
AVATAR_TTS_MODEL_DIR=
AVATAR_STT_PYTHON=
AVATAR_STT_MODEL_DIR=
HF_HOME=
